+// ─── Reusable field components ────────────────────────────────────────────────
+
+function CampoTexto({ label, value, error, placeholder, onChange, onBlur }: {
+  label: string;
+  value: string;
+  error?: string;
+  placeholder?: string;
+  onChange: (v: string) => void;
+  onBlur: () => void;
+}) {
+  return (
+    <div className="flex flex-col gap-1.5">
